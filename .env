# Tau on Jetson Orin Nano - local-only services
# Host ports (network_mode: host)
SPEACHES_HOST_PORT=8001
VLLM_PORT=8000
KOKORO_TTS_HOST_PORT=8880

# Image tags (L4T R36.5.0 on this machine; no r36.5 tags exist upstream,
# r36.4.0 images are CUDA 12.6 / L4T 36.x compatible)
SPEACHES_TAG=dustynv/speaches:r36.4.0-cu128-24.04
KOKORO_TTS_TAG=dustynv/kokoro-tts:fastapi-r36.4.0-cu128-24.04
OLLAMA_TAG=dustynv/ollama:r36.4.0

# Models
# 3B measured faster (18.4 tok/s) but OOMs with STT+TTS loaded on 8 GB.
# 1B runs together with all three services; use it as the production model.
OLLAMA_MODEL=llama3.2:1b
OLLAMA_FALLBACK_MODEL=llama3.2:3b
TTS_VOICE=af_alloy
# STT is Parakeet TDT 0.6B v2 (int8, sherpa-onnx, CPU) served by ./parakeet on :9002.
# The old Whisper service (speaches) only starts with: docker compose --profile whisper up
STT_MODEL=parakeet-tdt-0.6b-v2-int8

# GPU
NVIDIA_VISIBLE_DEVICES=all
